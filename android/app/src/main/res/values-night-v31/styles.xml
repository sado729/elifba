<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash screen: the adaptive launcher icon on a flat
         colour. windowSplashScreenBackground is the documented way to pick that colour.
         (Without it the system estimates one from windowBackground, which for this
         layer-list happens to be the same @color/splash_background.)
         This style REPLACES the LaunchTheme in values-night/styles.xml on API 31+, so keep
         the copies in values, values-night, values-v31 and values-night-v31 in sync.
         Theme applied while the process starts when the OS's Dark Mode setting is on. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
    </style>
</resources>
